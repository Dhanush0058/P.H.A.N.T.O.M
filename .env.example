# JARVIS - Personal AI Operating Assistant Configuration

# AI Provider Configuration (ollama, omniroute, gemini, openai, anthropic, custom, mock)
AI_PROVIDER=ollama
AI_MODEL=qwen2.5-coder:7b

# Ollama Local LLM (Infinite Free Tokens, 100% Offline, Zero Rate Limits)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# OmniRoute Gateway (~1.51B Free Tokens / Mo across 352 AI Providers)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto
OMNIROUTE_API_KEY=omniroute-free-key

# Fallback direct API keys (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server & Database
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///../data/jarvis.db

# Voice & Speech
DEFAULT_TTS_VOICE=en-US-ChristopherNeural
WAKE_WORD="hey jarvis"
VOICE_ENABLED=true

# Security Guardrails
AUTO_APPROVE_SAFE=true
ALLOW_TERMINAL=true
