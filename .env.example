# JARVIS - Personal AI Operating Assistant Configuration

# AI Provider Configuration (mistral, ollama, omniroute, gemini, openai, anthropic, custom, mock)
AI_PROVIDER=mistral
AI_MODEL=mistral-small-latest

# ==========================================
# 🌪️ MISTRAL AI CLOUD (Paste your key below)
# Get free key at: https://console.mistral.ai
# ==========================================
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# ==========================================
# 💻 OLLAMA LOCAL LLM (Offline fallback)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# ==========================================
# 🚀 OMNIROUTE GATEWAY (Multi-provider pool)
# ==========================================
PORT=20128
OMNIROUTE_PORT=20128
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto
OMNIROUTE_API_KEY=sk-28a84383edfe3771-ea2a68-70b434c7

# Other Direct API Keys (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server & Database
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///../data/jarvis.db

# Voice & Speech
DEFAULT_TTS_VOICE=en-US-ChristopherNeural
WAKE_WORD="hey jarvis"
VOICE_ENABLED=true

# Security Guardrails
AUTO_APPROVE_SAFE=true
ALLOW_TERMINAL=true
